  description="Two ways in: write to Victoria, or book straight into the calendar. Business coaching for women scaling past six figures without the burnout."
>
  <Navbar />
  <main id="main" tabindex="-1">
    <ContactHero />
    <ValuesMarquee />
    <Faq />
    <ContactCta />
  </main>
  <Footer />
</BaseLayout>
