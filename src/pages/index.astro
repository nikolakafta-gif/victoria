---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ValuesMarquee from "../components/ValuesMarquee.astro";
import Philosophy from "../components/Philosophy.astro";
import WorkWithMe from "../components/WorkWithMe.astro";
import Benefits from "../components/Benefits.astro";
import MeetTheCoach from "../components/MeetTheCoach.astro";
import Testimonials from "../components/Testimonials.astro";
import StarterGuide from "../components/StarterGuide.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Victoria — Business Coach for Women Entrepreneurs">
  <Navbar />
  <main id="main" tabindex="-1">
    <Hero />
    <ValuesMarquee />
    <Philosophy />
    <WorkWithMe />
    <Benefits />
    <MeetTheCoach />
    <ValuesMarquee variant="dark" />
    <Testimonials />
    <StarterGuide />
  </main>
  <Footer />
</BaseLayout>
