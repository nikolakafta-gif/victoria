---
const steps = [
  {
    title: "Book a free call",
    desc: "30 minutes. Zero pitch, full clarity on where your business leaks money and energy.",
  },
  {
    title: "Get your roadmap",
    desc: "We map your offer, pricing and capacity, and you keep it either way.",
  },
  {
    title: "Choose your pace",
    desc: "1:1, group or course. Same method, your level of support.",
  },
];
---

<section class="process">
  <div class="process__inner">
    <div class="process__head">
      <p class="section-label process__eyebrow">// The process</p>
      <h2 class="process__heading">How we start</h2>
    </div>

    <ol class="process__steps">
      {steps.map((s, i) => (
        <li class="process__step">
          <span class="process__counter">
            <span>{String(i + 1).padStart(2, "0")}</span>
            <span class="process__counter-sep">/</span>
            <span class="process__counter-total">{String(steps.length).padStart(2, "0")}</span>
          </span>
          <div class="process__step-body">
            <h3 class="process__step-title">{s.title}</h3>
            <p class="process__step-desc">{s.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    display: flex;
    justify-content: center;
    padding: 7.5em var(--container-padding); /* 120px */
    background-color: var(--color-bg-dark);
  }
  .process__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 4em;
    width: 100%;
    max-width: 82em; /* 1312px */
  }

  .process__head {
    display: flex;
    flex-direction: column;
    gap: 1em; /* 16px */
    flex-shrink: 0;
    max-width: 26.3125em; /* 421px */
  }
  .process__eyebrow {
    color: var(--color-text-white);
  }
  .process__heading {
    font-size: 5em; /* 80px */
    line-height: 1;
    letter-spacing: -3.2px;
    color: var(--color-text-white);
  }

  .process__steps {
    display: flex;
    flex-direction: column;
    gap: 5em; /* 80px */
    width: 33.3125em; /* 533px */
    max-width: 100%;
  }
  .process__step {
    display: flex;
    flex-direction: column;
    gap: 1.5em; /* 24px */
  }
  .process__counter {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.5em 1em; /* 8px 16px */
    border-radius: 16px;
    background-color: var(--color-accent);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1em; /* 16px */
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text-white);
  }
  .process__counter-sep {
    opacity: 0.2;
  }
  .process__counter-total {
    opacity: 0.5;
  }
  .process__step-body {
    display: flex;
    flex-direction: column;
    gap: 0.75em; /* 12px */
  }
  .process__step-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 2em; /* 32px */
    line-height: 1.125;
    letter-spacing: -0.32px;
    color: var(--color-text-white);
  }
  .process__step-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.125em; /* 18px */
    line-height: 1.333;
    letter-spacing: -0.36px;
    color: var(--color-text-white);
  }

  @media screen and (max-width: 991px) {
    .process {
      padding-block: 5em;
    }
    .process__inner {
      flex-direction: column;
      gap: 3em;
    }
    .process__heading {
      font-size: 3.5em;
    }
    .process__steps {
      width: 100%;
      gap: 3em;
    }
  }

  @media screen and (max-width: 767px) {
    .process {
      padding-block: 3em;
    }
    .process__heading {
      font-size: 3em; /* 48px */
      letter-spacing: -1.92px;
    }
    .process__step-title {
      font-size: 1.5em; /* 24px */
    }
    .process__step-desc {
      font-size: 1em; /* 16px */
    }
  }
</style>
