---
const links = [
  { label: "About", href: "/#about" },
  { label: "Work With Me", href: "/work-with-me" },
  { label: "Podcast", href: "/#podcast" },
  { label: "Blog", href: "/#blog" },
  { label: "Contact", href: "/contact" },
];

const menuColA = [
  { label: "Home", href: "/", active: true },
  { label: "Work with me", href: "/work-with-me" },
  { label: "Podcast", href: "/#podcast" },
  { label: "Blogs", href: "/#blog" },
  { label: "Contact", href: "/contact" },
];
const menuColB = [
  { label: "About", href: "/#about" },
  { label: "Programs", href: "/work-with-me" },
  { label: "Testimonials", href: "/#blog" },
  { label: "Resources", href: "/#blog" },
  { label: "FAQ", href: "/contact#faq" },
];
---

<header class="navbar">
  <div class="navbar__inner">
    <a class="navbar__logo" href="/">Victoria</a>

    <nav class="navbar__nav" aria-label="Primary">
      {links.map((l) => <a href={l.href} data-roll>{l.label}</a>)}
    </nav>

    <div class="navbar__cta">
      <a class="btn navbar__book" href="/contact">Book a free</a>
      <button
        class="navbar__menu"
        type="button"
        aria-label="Open menu"
        aria-controls="site-menu"
        aria-expanded="false"
        data-menu-open
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="site-menu" class="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-lenis-prevent>
  <div class="menu__inner">
    <div class="menu__media" data-menu-reveal>
      <img src="/assets/images/menu-portrait.webp" alt="" width="800" height="1062" />
    </div>

    <div class="menu__content">
      <div class="menu__top" data-menu-reveal>
        <span class="menu__label">Discover pages</span>
        <button class="menu__close" type="button" aria-label="Close menu" data-menu-close>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <nav class="menu__nav" aria-label="Menu">
        <ul class="menu__col">
          {menuColA.map((l) => (
            <li data-menu-reveal>
              <a href={l.href} class:list={["menu__link", { "is-active": l.active }]} data-menu-close>{l.label}</a>
            </li>
          ))}
        </ul>
        <ul class="menu__col">
          {menuColB.map((l) => (
            <li data-menu-reveal>
              <a href={l.href} class="menu__link" data-menu-close>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="menu__contact" data-menu-reveal>
        <span class="menu__label">Contact Us</span>
        <div class="menu__contact-lines">
          <p>(08) 8280 4768</p>
          <p>yourwebsite.com</p>
        </div>
      </div>

      <div class="menu__social" data-menu-reveal>
        <span class="menu__label">Stay Connected</span>
        <div class="menu__social-icons">
          <a href="#" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M23 7.5a3 3 0 0 0-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 0 0 1 7.5 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.5 12 31 31 0 0 0 23 7.5zM9.75 15.5v-7L15.5 12z"/></svg>
          </a>
          <a href="#" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M16.5 3c.3 2.1 1.5 3.6 3.5 3.9v2.5c-1.2.1-2.3-.3-3.5-1v5.9c0 4.3-3.4 6.7-6.9 5.6-3.2-1-4.2-5-1.9-7.5 1-1 2.3-1.5 3.7-1.4v2.6c-.4-.1-.9-.1-1.4 0-1.2.4-1.6 1.6-1.2 2.6.4 1.1 1.9 1.5 2.9.7.6-.5.8-1.2.8-2V3z"/></svg>
          </a>
          <a href="#" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H8v-2.9h2.4V9.8c0-2.4 1.4-3.7 3.6-3.7 1 0 2.1.2 2.1.2v2.3h-1.2c-1.2 0-1.5.7-1.5 1.5v1.8h2.6l-.4 2.9h-2.2v7A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4a3.8 3.8 0 0 1-1.4-.9 3.8 3.8 0 0 1-.9-1.4c-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zM12 6.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11zm0 9.1a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2zm5.7-9.3a1.3 1.3 0 1 1-2.6 0 1.3 1.3 0 0 1 2.6 0z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: var(--color-bg-soft-cream);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5em;
    width: 100%;
    max-width: var(--size-container);
    margin-inline: auto;
    padding: 0.75em var(--container-padding);
  }

  .navbar__logo {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.6em; /* ~25.8px */
    line-height: 1;
    letter-spacing: -0.52px;
    color: var(--color-logo);
    white-space: nowrap;
  }

  .navbar__nav {
    display: flex;
    align-items: center;
    gap: 2.5em; /* 40px */
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1em;
    color: var(--color-text-primary);
  }

  .navbar__cta {
    display: flex;
    align-items: center;
    gap: 1.5em; /* 24px */
  }

  .navbar__book {
    font-size: 1em;
    padding: 0.75em 1em; /* 12px 16px */
  }

  .navbar__menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.375em;
    height: 2.5em;
    background: none;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
  }
  .navbar__menu svg {
    width: 1.5em;
    height: 1.5em;
  }

  /* Tablet & below: collapse primary nav to the menu button */
  @media screen and (max-width: 991px) {
    .navbar__nav {
      display: none;
    }
  }

  @media screen and (max-width: 767px) {
    .navbar__book {
      display: none;
    }
    .navbar__logo {
      font-size: 1.41em; /* ~22.6px */
    }
  }

  /* ==========================================================================
     Full-screen menu overlay
     ========================================================================== */

  .menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    background-color: var(--color-bg-dark);
    color: rgba(239, 231, 217, 0.9);
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }

  .menu__inner {
    display: flex;
    gap: 4em; /* 64px */
    min-height: 100%;
    padding: 4em; /* 64px */
  }

  .menu__media {
    flex: 1 1 0;
    align-self: stretch;
    overflow: hidden;
    min-height: 32em;
  }
  .menu__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu__content {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 4.5em; /* 72px */
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu__label {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.8125em; /* 13px */
    line-height: 1.85;
    text-transform: uppercase;
    color: rgba(239, 231, 217, 0.55);
  }

  .menu__close {
    display: inline-flex;
    padding: 0;
    background: none;
    border: none;
    color: rgba(239, 231, 217, 0.9);
    cursor: pointer;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }
  .menu__close:hover {
    color: var(--color-text-white);
    transform: rotate(90deg);
  }
  .menu__close svg {
    width: 1.5em;
    height: 1.5em;
  }

  .menu__nav {
    display: flex;
    gap: 4em;
  }
  .menu__col {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 0.875em; /* 14px */
  }
  .menu__link {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.5em; /* 24px */
    line-height: 1.5; /* 36/24 */
    color: rgba(239, 231, 217, 0.9);
    transition: color var(--transition-fast);
  }
  /* Animated underline — grows left→right on hover/focus. */
  .menu__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0.2em;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
  }
  .menu__link:hover,
  .menu__link:focus-visible {
    color: var(--color-text-white);
  }
  .menu__link:hover::after,
  .menu__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu__link::after {
      transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
    }
  }

  .menu__contact {
    display: flex;
    flex-direction: column;
    gap: 0.625em; /* 10px */
  }
  .menu__contact-lines {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.9375em; /* 15px */
    line-height: 1.733;
    color: rgba(239, 231, 217, 0.8);
  }

  .menu__social {
    display: flex;
    flex-direction: column;
    gap: 1em; /* 16px */
  }
  .menu__social-icons {
    display: flex;
    gap: 1.5em; /* 24px */
  }
  .menu__social-icons a {
    color: rgba(239, 231, 217, 0.9);
    transition: opacity var(--transition-fast);
  }
  .menu__social-icons a:hover {
    opacity: 0.7;
  }
  .menu__social-icons svg {
    width: 1.5em;
    height: 1.5em;
  }

  @media screen and (max-width: 991px) {
    .menu__inner {
      gap: 2em;
      padding: var(--container-padding);
    }
    .menu__media {
      display: none;
    }
  }

  @media screen and (max-width: 479px) {
    .menu__content {
      gap: 3em;
    }
    .menu__nav {
      gap: 2em;
    }
    .menu__link {
      font-size: 1.25em;
    }
  }
</style>

<script>
  import gsap from "gsap";

  const menu = document.getElementById("site-menu");
  const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");

  if (menu && openBtn) {
    const reveals = menu.querySelectorAll("[data-menu-reveal]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let open = false;

    // Build a paused timeline: panel slides in from the right, then content
    // rises from below in a top-to-bottom stagger.
    const tl = gsap.timeline({
      paused: true,
      onStart: () => {
        menu.hidden = false;
        window.lenis?.stop();
        document.body.style.overflow = "hidden";
        openBtn.setAttribute("aria-expanded", "true");
      },
      onReverseComplete: () => {
        menu.hidden = true;
        window.lenis?.start();
        document.body.style.overflow = "";
        openBtn.setAttribute("aria-expanded", "false");
        openBtn.focus();
      },
    });

    if (reduce) {
      tl.set(menu, { xPercent: 0, autoAlpha: 1 }).set(reveals, { autoAlpha: 1, y: 0 });
    } else {
      tl.fromTo(
        menu,
        { xPercent: 100, autoAlpha: 1 },
        { xPercent: 0, duration: 0.6, ease: "power4.out" }
      ).from(
        reveals,
        { autoAlpha: 0, y: 28, duration: 0.5, stagger: 0.05, ease: "power2.out" },
        "-=0.25"
      );
    }

    const openMenu = () => {
      if (open) return;
      open = true;
      tl.play();
      // Move focus into the dialog once it has started opening.
      const closeBtn = menu.querySelector<HTMLButtonElement>("[data-menu-close]");
      requestAnimationFrame(() => closeBtn?.focus());
    };

    const closeMenu = () => {
      if (!open) return;
      open = false;
      tl.reverse();
    };

    openBtn.addEventListener("click", openMenu);
    menu.querySelectorAll("[data-menu-close]").forEach((el) =>
      el.addEventListener("click", closeMenu)
    );

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) closeMenu();
    });

    // Basic focus trap while the menu is open.
    menu.addEventListener("keydown", (e) => {
      if (e.key !== "Tab" || !open) return;
      const focusables = menu.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled])'
      );
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
