---
const linksA = [
  { label: "Home", href: "/" },
  { label: "Work with me", href: "/work-with-me" },
  { label: "Podcast", href: "/#podcast" },
  { label: "Blogs", href: "/#blog" },
  { label: "Contact", href: "/contact" },
];
const linksB = [
  { label: "About", href: "/#about" },
  { label: "Programs", href: "/work-with-me" },
  { label: "Testimonials", href: "/#blog" },
  { label: "Resources", href: "/#blog" },
  { label: "FAQ", href: "/contact#faq" },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <p class="footer__logo">Victoria</p>
        <div class="footer__contact">
          <p class="footer__contact-title">Contact Us</p>
          <div class="footer__contact-lines">
            <p>(08) 8280 4768</p>
            <p>yourwebsite.com</p>
          </div>
        </div>
      </div>

      <nav class="footer__links" aria-label="Footer">
        {linksA.map((l) => <a href={l.href} data-roll>{l.label}</a>)}
      </nav>
      <nav class="footer__links" aria-label="Footer secondary">
        {linksB.map((l) => <a href={l.href} data-roll>{l.label}</a>)}
      </nav>
    </div>

    <div class="footer__social">
      <p class="footer__social-title">Stay Connected</p>
      <div class="footer__social-icons">
        <a href="#" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M23 7.5a3 3 0 0 0-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 0 0 1 7.5 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.5 12 31 31 0 0 0 23 7.5zM9.75 15.5v-7L15.5 12z"/></svg>
        </a>
        <a href="#" aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M16.5 3c.3 2.1 1.5 3.6 3.5 3.9v2.5c-1.2.1-2.3-.3-3.5-1v5.9c0 4.3-3.4 6.7-6.9 5.6-3.2-1-4.2-5-1.9-7.5 1-1 2.3-1.5 3.7-1.4v2.6c-.4-.1-.9-.1-1.4 0-1.2.4-1.6 1.6-1.2 2.6.4 1.1 1.9 1.5 2.9.7.6-.5.8-1.2.8-2V3z"/></svg>
        </a>
        <a href="#" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H8v-2.9h2.4V9.8c0-2.4 1.4-3.7 3.6-3.7 1 0 2.1.2 2.1.2v2.3h-1.2c-1.2 0-1.5.7-1.5 1.5v1.8h2.6l-.4 2.9h-2.2v7A10 10 0 0 0 22 12z"/></svg>
        </a>
        <a href="#" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4a3.8 3.8 0 0 1-1.4-.9 3.8 3.8 0 0 1-.9-1.4c-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zM12 6.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11zm0 9.1a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2zm5.7-9.3a1.3 1.3 0 1 1-2.6 0 1.3 1.3 0 0 1 2.6 0z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__divider"></div>
      <div class="footer__bottom-row">
        <p>© 2026 Victoria. All rights reserved</p>
        <p>Policies and Terms</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: center;
    padding: 4em var(--container-padding) 2em; /* 64 / 32 */
    background-color: var(--color-bg-dark);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 4em; /* 64px */
    width: 100%;
    max-width: 82em; /* 1312px */
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr auto auto; /* brand left, link columns pushed to the far right */
    column-gap: 5em;
    row-gap: 1.5em;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 2.5em; /* 40px */
  }
  .footer__logo {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 3em; /* 48px */
    line-height: 1;
    letter-spacing: -0.96px;
    color: var(--color-text-white);
  }
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.625em; /* 10px */
    font-family: var(--font-body);
    font-weight: 300;
  }
  .footer__contact-title {
    font-size: 1.75em; /* 28px */
    line-height: 1.428;
    letter-spacing: -0.28px;
    color: rgba(239, 231, 217, 0.55);
  }
  .footer__contact-lines {
    font-size: 1.125em; /* 18px */
    line-height: 1.333;
    letter-spacing: -0.36px;
    color: rgba(239, 231, 217, 0.8);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.875em; /* 14px */
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.75em; /* 28px */
    line-height: 1.428;
    letter-spacing: -0.28px;
  }
  .footer__links a {
    color: rgba(239, 231, 217, 0.9);
    transition: color var(--transition-fast);
  }
  .footer__links a:hover {
    color: var(--color-text-white);
  }

  .footer__social {
    display: grid;
    grid-template-columns: minmax(0, 533px) minmax(0, 316px) 1fr;
    gap: 1.5em;
  }
  .footer__social-title {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 1em;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.8125em; /* 13px */
    line-height: 1.85;
    text-transform: uppercase;
    color: rgba(239, 231, 217, 0.55);
  }
  .footer__social-icons {
    grid-column: 2;
    display: flex;
    gap: 1.5em; /* 24px */
    margin-top: 1em;
  }
  .footer__social-icons a {
    color: rgba(239, 231, 217, 0.9);
    transition: opacity var(--transition-fast);
  }
  .footer__social-icons a:hover {
    opacity: 0.7;
  }
  .footer__social-icons svg {
    width: 1.5em;
    height: 1.5em;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25em; /* 20px */
  }
  .footer__divider {
    width: 100%;
    height: 1px;
    background-color: rgba(239, 231, 217, 0.15);
  }
  .footer__bottom-row {
    display: grid;
    grid-template-columns: minmax(0, 533px) 1fr 1fr;
    gap: 1.5em;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.125em; /* 18px */
    line-height: 1.333;
    letter-spacing: -0.36px;
    color: rgba(239, 231, 217, 0.5);
  }
  .footer__attribution {
    text-align: right;
  }

  @media screen and (max-width: 991px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
    .footer__social {
      grid-template-columns: 1fr;
    }
    .footer__social-title,
    .footer__social-icons {
      grid-column: 1;
    }
    .footer__bottom-row {
      grid-template-columns: 1fr 1fr;
    }
    .footer__attribution {
      text-align: left;
    }
  }

  @media screen and (max-width: 767px) {
    .footer {
      padding-block: 2.5em;
    }
    /* keeps the two-column top from the ≤991 rule; brand row = logo + contact */
    .footer__brand {
      flex-direction: row;
      gap: 0.75em; /* 12px */
    }
    .footer__logo {
      flex: 1;
      font-size: 2em; /* 32px */
    }
    .footer__contact {
      flex: 1;
    }
    .footer__contact-title {
      font-size: 1.125em; /* 18px */
    }
    .footer__contact-lines {
      font-size: 0.875em; /* 14px */
    }
    .footer__links {
      font-size: 1.25em; /* 20px */
    }
    .footer__bottom-row {
      grid-template-columns: 1fr;
      gap: 0.5em;
      font-size: 0.75em; /* 12px */
    }
  }
</style>
