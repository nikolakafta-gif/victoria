---
const points = [
  "Revenue exists, systems don't, and you're past the idea stage",
  "You're done trading sleep for growth",
  "You want a coach who opens the spreadsheet, not just the chakras",
  "You can invest 3 to 5 hours a week in the work",
];
---

<section class="outcomes">
  <div class="outcomes__inner">
    <div class="outcomes__head">
      <p class="section-label outcomes__eyebrow">// Client outcomes</p>
      <h2 class="outcomes__heading">Let&rsquo;s save us both time</h2>
    </div>

    <div class="outcomes__body">
      <ul class="outcomes__list">
        {points.map((p) => (
          <li class="outcomes__point">
            <span class="outcomes__check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 3h18v18H3V3zm7.6 13.2l7-7-1.4-1.4-5.6 5.6-2.8-2.8L6.4 12l4.2 4.2z" />
              </svg>
            </span>
            <span>{p}</span>
          </li>
        ))}
      </ul>

      <div class="outcomes__media">
        <img src="/assets/images/wwm-outcomes.webp" alt="Two women in conversation over coffee" width="1500" height="1000" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .outcomes {
    display: flex;
    justify-content: center;
    padding: 7.5em var(--container-padding); /* 120px */
    background-color: var(--color-bg-soft-cream);
  }
  .outcomes__inner {
    display: flex;
    flex-direction: column;
    gap: 6.5em; /* 104px */
    width: 100%;
    max-width: 82em; /* 1312px */
  }

  .outcomes__head {
    display: flex;
    flex-direction: column;
    gap: 1em; /* 16px */
  }
  .outcomes__eyebrow {
    color: var(--color-accent);
  }
  .outcomes__heading {
    font-size: 5em; /* 80px */
    line-height: 1;
    letter-spacing: -3.2px;
    color: var(--color-text-primary);
  }

  .outcomes__body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4em;
  }
  .outcomes__list {
    display: flex;
    flex-direction: column;
    gap: 1.25em; /* 20px */
    width: 26.3125em; /* 421px */
    flex-shrink: 0;
  }
  .outcomes__point {
    display: flex;
    align-items: flex-start;
    gap: 1.25em; /* 20px */
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.125em; /* 18px */
    line-height: 1.333;
    letter-spacing: -0.36px;
    color: var(--color-text-secondary);
  }
  .outcomes__check {
    flex-shrink: 0;
    display: block;
    width: 1.5em; /* 24px */
    height: 1.5em;
    color: var(--color-accent);
  }
  .outcomes__check svg {
    width: 100%;
    height: 100%;
  }

  .outcomes__media {
    width: 47.1875em; /* 755px */
    height: 36.25em; /* 580px */
    flex-shrink: 1;
    min-width: 0;
  }
  .outcomes__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 991px) {
    .outcomes {
      padding-block: 5em;
    }
    .outcomes__inner {
      gap: 3em;
    }
    .outcomes__heading {
      font-size: 3.5em;
    }
    .outcomes__body {
      flex-direction: column;
      align-items: stretch;
      gap: 2.5em;
    }
    .outcomes__list {
      width: 100%;
      order: 1;
    }
    .outcomes__media {
      width: 100%;
      height: auto;
      aspect-ratio: 755 / 580;
      order: 0;
    }
  }

  @media screen and (max-width: 767px) {
    .outcomes {
      padding-block: 3em;
    }
    .outcomes__heading {
      font-size: 2.5em; /* 40px */
      letter-spacing: -1.6px;
    }
    .outcomes__point {
      font-size: 1em; /* 16px */
      gap: 1em;
    }
  }
</style>
