---
---

<section class="whero" id="top">
  <div class="whero__media" aria-hidden="true">
    <img src="/assets/images/wwm-hero.webp" alt="" width="1800" height="1200" fetchpriority="high" />
  </div>

  <div class="whero__inner">
    <div class="whero__content">
      <p class="section-label whero__eyebrow">// Work with me</p>
      <h1 class="whero__heading">Business that<br />pays you and frees you.</h1>
      <p class="whero__desc">
        The same method, the Sustainable Scale Method, at three levels of access
        and investment. Pick your pace.
      </p>
    </div>
  </div>
</section>

<style>
  .whero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 50.4375em; /* 807px */
    background-color: var(--color-bg-dark);
    overflow: hidden;
  }

  .whero__media {
    position: absolute;
    inset: 0;
  }
  .whero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }
  /* Dark scrim so the white copy stays legible over the photo */
  .whero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(34, 6, 3, 0.85) 0%,
      rgba(34, 6, 3, 0.6) 45%,
      rgba(34, 6, 3, 0.1) 100%
    );
  }

  .whero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 90em; /* 1440px design frame */
    margin-inline: auto;
    padding: 4em;
  }
  .whero__content {
    display: flex;
    flex-direction: column;
    gap: 2em; /* 32px */
    max-width: 40.4375em; /* 647px */
  }
  .whero__eyebrow {
    color: var(--color-text-white);
  }
  .whero__heading {
    font-size: 5em; /* 80px */
    line-height: 1;
    letter-spacing: -3.2px;
    color: var(--color-text-white);
  }
  .whero__desc {
    /* em max-width resolves against THIS element's font-size (18px), so 536px = 29.78em */
    max-width: 29.78em; /* 536px */
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.125em; /* 18px */
    line-height: 1.333;
    letter-spacing: -0.36px;
    color: var(--color-text-white);
  }

  @media screen and (max-width: 991px) {
    .whero {
      min-height: 40em;
    }
    .whero__inner {
      padding: 4em var(--container-padding);
    }
    .whero__heading {
      font-size: 3.75em; /* 60px */
    }
    .whero__media::after {
      background: linear-gradient(
        180deg,
        rgba(34, 6, 3, 0.5) 0%,
        rgba(34, 6, 3, 0.8) 100%
      );
    }
  }

  @media screen and (max-width: 767px) {
    .whero {
      min-height: 32em;
    }
    .whero__inner {
      padding-block: 3em;
    }
    .whero__content {
      gap: 1.5em;
    }
    .whero__heading {
      font-size: 3em; /* 48px */
      letter-spacing: -1.92px;
    }
    .whero__desc {
      font-size: 0.875em; /* 14px */
      line-height: 1.428;
    }
  }
</style>
